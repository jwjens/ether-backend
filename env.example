# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PRICE_PRO=price_1TCwR6QJRnsdUhPM6RPqhjdA
PRICE_STATION=price_1TCwRZQJRnsdUhPMjwK0y9sA

# Database (Railway provides this automatically)
DATABASE_URL=postgresql://...

# Email (get free API key from resend.com)
RESEND_API_KEY=re_...

# Admin secret (make up any long random string)
ADMIN_SECRET=change_this_to_something_long_and_random

# Cloudflare R2 (object storage for audio files + DB backups)
# Backend signs short-lived URLs for customer uploads/downloads — customers
# never hold these credentials. Without these set, /audio/* and /backup/*
# endpoints return 503 r2_not_configured (rest of the API keeps working).
R2_ACCOUNT_ID=
R2_BUCKET=ether-audio
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional override — defaults to https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT=
